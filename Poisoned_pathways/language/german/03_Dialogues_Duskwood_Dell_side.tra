// game: Poisoned Pathways
// date: 2026-08-04, 21:34
// Caution: This file is in UTF-8 format because it uses several special characters of non-english languages

@3700 = ~Große Ohren, noch größere Geschichten. Ruhe! Jetzt kommt der beste Teil.~
@3701 = ~Pssst! Wenn Ihr Krach macht, vergesse ich, wo wir in der Geschichte waren.~
@3702 = ~Verschwindet! Ich habe einen warmen Platz, eine gute Geschichte und keine Geduld für Störungen.~
@3703 = ~Jede Geschichte braucht Stille, um zu wachsen – wie eine Wurzel in der Erde. Ihr trampelt darauf herum.~
@3704 = ~Bitte! Ich lausche ganz aufmerksam. Einen Bären mit solch einem Sinn für Erzählkunst trifft man selten.~
@3705 = ~Und so, meine Kleinen, rettete das Eichhörnchen die Eiche davor, vom Sturm entwurzelt zu werden, indem es ihn zum Husten brachte.~
@3706 = ~Das war wundervoll! Ich mochte den Teil, wo die Wolken vor Lachen geweint haben.~
@3707 = ~Du magst immer die lustigen Stellen. Ich mochte, wie das Eichhörnchen sogar den Donner überlistet hat.~
@3708 = ~Die Geschichte war ungerecht. Der Käfer hat es nicht verdient, zerquetscht zu werden.~
@3709 = ~Ich bleib dabei, der Käfer hats verdient. Dummer Käfer.~
@3710 = ~Es ist doch nur eine Geschichte … oder etwa nicht? Vielleicht ist so etwas wirklich einmal geschehen?~
@3711 = ~In jeder Geschichte steckt ein wenig Wahrheit, meine Kleinen. Ihr müsst mit mehr als nur den Ohren lauschen.~
@3712 = ~Mit Ohren wie meinen höre ich alles!~
@3713 = ~Meine sind nicht so groß, doch ich höre trotzdem gerne zu. Meistens jedenfalls …~
@3714 = ~Kennt Ihr noch eine weitere Geschichte? Eine mit einem Kaninchen vielleicht?~
@3715 = ~Nun gut. Setzt euch. Dies ist die Geschichte vom mondbeschienenen Hain und dem Kaninchen, das der Zeit davonlief …~
@3716 = ~Oh nein … nicht schon wieder diese alte Zeitgeschichte …~
@3717 = ~Pssst! Ich liebe diese Fabel.~
@3718 = ~Vor langer Zeit, noch ehe die Sterne Namen trugen …~
@3719 = ~Ooooh!~
@3720 = ~Seid gegrüßt, Zweibeiner. Hört ruhig zu, aber erschreckt meine Kleinen nicht, ja? Ich erzähle hier Geschichten.~
@3721 = ~Und so, meine Kleinen, überlistete der Igel die Sonne, damit sie verschlief und die Blumen noch ein wenig ruhen konnten.~
@3722 = ~Der Igel war klug! Ich wette, der kriegt nie einen Sonnenbrand.~
@3723 = ~Ich finde es unhöflich, die Sonne zu täuschen. Was, wenn sie beleidigt ist?~
@3724 = ~Dann hätten wir immer Nacht! Stellt Euch vor, wie viele Nüsse ich verstecken könnte!~
@3725 = ~Was hat die Sonne danach gemacht? Hat sie den Igel gejagt?~
@3726 = ~Das ist eine andere Geschichte … für ein anderes Mal.~
@3727 = ~Einst verliebte sich der Wind in eine Lerche und folgte ihr so dicht, dass er all ihre Federn verkehrt herum blies.~
@3728 = ~Darum sehen Vögel nach einem Sturm immer so zerzaust aus! Ich wusste es!~
@3729 = ~Ist das der Grund, warum der Wind immer pfeift? Weil er das Lied der Vögel singt?~
@3730 = ~Die Lerche hätte ein Wiegenlied singen sollen. Hätte den Wind vielleicht beruhigt.~
@3731 = ~Aber was ist mit ihr geschehen? Ist sie davongeflogen?~
@3732 = ~Sie sang einen letzten Ton, so süß, dass der Wind ihn um die ganze Welt trug. Manche sagen, er hallt noch immer nach, in der Stille kurz vor einer Dämmerung.~
@3733 = ~Und so kletterte die Maus auf die Schulter des alten Wolkenriesen, um ihm ein Gedicht in sein trauriges Ohr zu flüstern.~
@3734 = ~Das ist keine Tapferkeit. Das ist Dummheit auf Pfoten.~
@3735 = ~Was nützt ein Gedicht gegen ein Wesen, das größer ist als zehn Bäume?~
@3736 = ~Nicht die Größe der Pfoten zählt, sondern die Schärfe des Verstands.~
@3737 = ~Ich habe einmal eine Harfensaite angenagt und zum Reißen gebracht. Zählt das?~
@3738 = ~Wenn der Riese draufgetreten wäre, gäbs keine Geschichte. Nur Matsche.~
@3739 = ~Doch der Riese trat nicht. Er hörte zu. Und einen Augenblick lang wurde die Welt ein wenig gütiger.~
@3740 = ~Willkommen, Wanderer. Wenige gelangen zufällig ins Dämmerwaldtal. Was führt Euch unter diese Zweige?~
@3741 = ~Was ist das für ein Ort?~
@3742 = ~Ich möchte mehr über die Kirche Eldaths erfahren.~
@3743 = ~Ich suche Euren Hohepriester.~
@3744 = ~Ich suche den Feuchtfrohlockten Flegelweiner Alabath Bumbelditsch.~
@3745 = ~Ich suche immer noch den Moosverherrlichenden Fallenschipper Alatoss Boringdim.~
@3746 = ~Ich bemühe mich, den Feucht Ausatmenden Fehlwischer Alatut Buschbrennt zu finden.~
@3747 = ~Noch immer kein Glück beim Auffinden des Höchstermüdeten Flachhüters Alatrost Beerentrunk.~
@3748 = ~Meine Suche gilt dem Höchstaufgeblasenen Vielschläfer Analoss Babbelbim.~
@3749 = ~Ich suche den Hochverehrten Hüter der Stillen Wasser Alatoasz Berendim.~
@3750 = ~Ich suche einen Regenwurm. Habt Ihr zufällig einen gesehen?~
@3751 = ~Dies ist nicht der Augenblick für stille Einkehr.~
@3752 = ~Bevor Ihr fragt, Ihr findet den Hochverehrten Hüter der Stillen Wasser Alatoasz Berendim im nordöstlichen Baumhaus nahe dem Wasser. Noch etwas?~
@3753 = ~Erzählt mir von diesem Ort.~
@3754 = ~Es geht um die Zwielicht-Zwillinge.~
@3755 = ~Seid abermals gegrüßt. Was kann ich für Euch tun, Sucher des Friedens?~
@3756 = ~Möge Euer Pfad sanft und Euer Geist ungestört sein.~
@3757 = ~Ein Wort, <CHARNAME>. Ihr spracht vor kurzem mit den zwei kleinen Feen, die sich „Zwielicht-Zwillinge“ nennen.~
@3758 = ~Ihr meint diese beiden Plagegeister, die ständig lachen und leuchten?~
@3759 = ~Ach ja, das kleine Paar, das des Nachts das Tal erhellt. Was ist mit ihnen?~
@3760 = ~Die Zwielicht-Zwillinge? Sie wirkten ganz unauffällig – ein wenig zu redselig vielleicht.~
@3761 = ~Diese beiden Feen waren entzückend. Bitte sagt mir nicht, dass ihnen etwas zugestoßen ist.~
@3762 = ~Sie mögen zuweilen ein wenig lästig sein, aber sie gehören seit Langem zum Leben hier im Dämmerwaldtal dazu. Ich fürchte, ihnen ist etwas zugestoßen, denn sie sind spurlos verschwunden.~
@3763 = ~Ich fürchte, sie sind zu Schaden gekommen … oder schlimmer noch, man hat sie entführt.~
@3764 = ~Entführt?~
@3765 = ~Dafür habe ich keine Zeit.~
@3766 = ~Entführt, ja. Sie verließen das Tal in der Abenddämmerung und sagten, sie wollten ein Abenteuer erleben. Ich sandte eine Eule aus, um sie im Blick zu behalten – nur für alle Fälle.~
@3767 = ~Der Vogel folgte ihnen auf der Eshpurta-Straße in Richtung Athkatla. Er sah, wie sie mit einem Händler sprachen, und dann … verschwanden sie einfach. Der Händler zog allein weiter nach Westen.~
@3768 = ~Meine Eule verlor ihn aus den Augen, eine Mäusefamilie am Wegesrand lenkte sie ab. Doch sagt mir, <CHARNAME>, was für ein Händler bereist des Nachts diese Straße, ohne Wachen? Und weshalb kehrten die Zwillinge nicht zurück oder sandten seitdem ein Zeichen?~
@3769 = ~Vielleicht wurden sie aus Angst unsichtbar und verstecken sich irgendwo?~
@3770 = ~Wenn das wieder einer ihrer Streiche ist, falle ich nicht darauf herein.~
@3771 = ~Ich werde nach ihnen suchen.~
@3772 = ~Dafür habe ich keine Zeit. Sucht jemand anderen.~
@3773 = ~Ich bezweifle es. So lange sind sie noch nie fortgeblieben.~
@3774 = ~Dafür habe ich keine Zeit.~
@3775 = ~Habt Dank! Wie gesagt, der Händler war auf dem Weg nach Athkatla. Wo er sich in dieser gewaltigen Stadt aufhält, vermag ich nicht zu sagen. Doch Ihr kennt Euch dort gewiss besser aus als ich. Vielleicht wäre ein Ort, an dem Händler sich versammeln, der beste Anfang?~
@3776 = ~Dort gibt es einen großen Markt – Waukeens Promenade.~
@3777 = ~Habt Ihr eine Beschreibung dieses Händlers?~
@3778 = ~Er trug leuchtend rote Seide und wirkte nicht gerade bescheiden, wenn Ihr mich fragt. Er muss wohlhabend gewesen sein, was es nur umso seltsamer macht, dass er die Eshpurta-Straße allein und nachts, ohne Wachen, entlangging. Er sprach außerdem mit einem sonderbaren Akzent und rollte das „R“ sehr deutlich. Ansonsten war nichts Ungewöhnliches an ihm zu erkennen … zumindest mit den Augen einer Eule.~
@3779 = ~In Athkatla gibt es einen großen Markt – Waukeens Promenade. Dort beginne ich meine Suche und halte nach einem Händler in roter Seide Ausschau.~
@3780 = ~Habt Dank, dass Ihr Euch den Feen annehmt. Bitte bringt die Zwillinge wohlbehalten ins Dämmerwaldtal zurück. Es wäre leerer ohne ihre Streiche und ihr Lachen.~
@3781 = ~Ich verstehe. Ich hatte gehofft, Ihr würdet uns helfen, doch dann werde ich anderswo um Hilfe bitten.~
@3782 = ~Oh, Ihr sucht den Hochverehrten Hüter der Stillen Wasser Alatoasz Berendim? Ihr findet ihn in einem der Bäume – dem nordöstlichen, nahe dem Wasser. Sehr wahrscheinlich in den Wipfeln, wo er mit den Vögeln über Angelegenheiten des Waldes spricht.~
@3783 = ~Gut. Ich werde ihn dort aufsuchen.~
@3784 = ~Na dann, ab in die Bäume.~
@3785 = ~Ich habe noch eine Frage.~
@3786 = ~Ihr meint gewiss den Hochverehrten Hüter der Stillen Wasser Alatoasz Berendim. Bitte verspottet seinen Namen nicht. Es ist ein heiliger Titel. Ihr findet ihn im nordöstlichen Baumhaus nahe dem Wasser.~
@3787 = ~Seltsamer Name für einen heiligen Mann, doch Minsk kennt seltsamere! Vorwärts zum Baum am Wasser!~
@3788 = ~Äh, gut. Ich werde ihn dort aufsuchen.~
@3789 = ~Verzeiht. Ich mache mich auf den Weg.~
@3790 = ~(seufz) Es heißt Hochverehrter Hüter der Stillen Wasser Alatoasz Berendim. Zeigt etwas Ehrfurcht. Dies ist ein Heiligtum, keine Schenke voller Gaukler. Ihr findet ihn im nordöstlichen Baumhaus am Wasser. Und sammelt Euch, bevor Ihr mit ihm sprecht.~
@3791 = ~Warum stellt Ihr immer wieder dieselbe Frage, <CHARNAME>? Wir wissen doch, dass der Priester, den Ihr sucht, im Baum am Wasser lebt.~
@3792 = ~Müsst Ihr wirklich einen Diener Eldaths verspotten? Ihre Geduld ist keine Herausforderung für Euer Vergnügen. Begegnet ihnen mit Respekt!~
@3793 = ~Oh, nur zu, <CHARNAME>! Ich genieße es, fromme Narren zappeln zu sehen.~
@3794 = ~Verzeihung. Ich gehe zu seinem Baum.~
@3795 = ~Ich habe gegen Drachen gekämpft, die kürzere Namen hatten. Wie auch immer, ich gehe.~
@3796 = ~Hochverehrter Hüter der Stillen Wasser Alatoasz Berendim! Nichts anderes! Bei den stillen Wassern, wie schwer ist das? Zeigt Ehrfurcht oder selbst die Bäume seufzen noch über Eure Unwissenheit. Nur zu, Ihr findet ihn am Baum direkt beim Ufer.~
@3797 = ~Einen Priester des Friedens zu reizen … Welche Melodie erwartet Ihr, mein Rabe? Einen Schrei? Ein Sonett? In stillen Wassern liegt keine Dramatik.~
@3798 = ~Es ist töricht, die Geduld dessen zu prüfen, der geschworen hat, sie nie zu verlieren. Es liegt keine Ehre darin, Beherrschung zu verhöhnen.~
@3799 = ~Ein wenig Lästerung hat noch niemandem geschadet, außer vielleicht dem Stolz frommer Schwächlinge.~
@3800 = ~Man sagt, Worte stechen tiefer als Klingen. Fast tut mir dieses moosverwirrte Relikt leid. Fast.~
@3801 = ~Na los, sehen wir, ob der Priester seine friedliche Haut abstreift und Zähne zeigt!~
@3802 = ~Verzeiht, ich bin nur schlecht mit so vielen albernen Silben. Lebt wohl.~
@3803 = ~Hochverehrter Hüter der Stillen Wasser Alatoasz Berendim! Sprecht es nach: Be-ren-dim! Und wenn Ihr es nicht hinbekommt, dann haltet wenigstens den Mund, während Ihr nach Nordosten zu seinen Gemächern geht.~
@3804 = ~Keine Sorge, wir nennen ihn von jetzt an einfach „Berri“.~
@3805 = ~Hah. Es braucht Witz, nicht Wucht, um einen Priester des Friedens aus der Fassung zu bringen. (Natürlich beherrsche ich beides.)~
@3806 = ~Ich wollte niemanden beleidigen. Lebt wohl.~
@3807 = ~Genug! Ihr tätet gut daran, die Stille dieses Hains zu nutzen, um über Euer Benehmen nachzudenken.~
@3808 = ~Tut das. Er wird Euch gern empfangen.~
@3809 = ~Oh! Habt Ihr sie gefunden?~
@3810 = ~Der Händler war ein verkleideter Rakshasa. Er hatte die Zwillinge gefangen. Sie sind nun in diesem Glasgefäß – lebendig und unversehrt, doch es lässt sich nicht öffnen.~
@3811 = ~Noch nicht, ich suche weiter.~
@3812 = ~Bei den Göttern, welch ein Glück! Lasst mich sehen …~
@3813 = ~Sie sehen unverletzt aus! Eldath sei gepriesen. Sind sie in diesem Gefäß gefangen?~
@3814 = ~Das Glasgefäß lässt sich nicht öffnen.~
@3815 = ~Schüttelt es! Vielleicht hilft das.~
@3816 = ~Soll ich es mit einem Hammer zerschlagen?~
@3817 = ~Lasst sie drin! Die Stille steht ihnen gut.~
@3818 = ~Dieses Gefäß ist außerhalb des Dämmerwaldtals versiegelt … doch hier, an diesem Ort des Friedens, kann nichts Lebendiges gefangen bleiben. Seht genau hin, die Versiegelung öffnet sich so leicht, wie Dunkelheit vor Licht weicht.~
@3819 = ~Bitte sucht weiter. Ich fürchte um sie mit jedem vergehenden Tag.~
@3820 = ~Regenwürmer? Ihr müsstet den ganzen heiligen Boden umgraben, um einen zu finden. Nein, ich fürchte, dabei kann ich Euch nicht helfen.~
@3821 = ~Das wäre alles. Lebt wohl.~
@3822 = ~Ihr habt Fragen? Gern! Ich hoffe nur, ich habe auch Antworten, die Euch gefallen.~
@3823 = ~Ich muss weiter.~
@3824 = ~Unsere Kirche wird vom Hochverehrten Hüter der Stillen Wasser, Alatoasz Berendim, geleitet – dem Weisesten und Friedvollsten unter uns. Alle anderen Priester, die Ihr hier seht, dienen unter seiner Führung. Anders als viele Glaubensgemeinschaften kennen wir keine starre Hierarchie, unser Glaube an die Harmonie der Natur eint uns und lenkt unseren Dienst an der Gemeinschaft.~
@3825 = ~Bisweilen werden Priester ausgesandt, um Frieden in die Welt zu bringen. Wir nennen sie Freiwandler. Sie reisen an Orte, die ihnen unsere Göttin weist, um Zwietracht zu schlichten oder Streit beizulegen. Ein gefährlicher, doch ein würdiger Pfad.~
@3826 = ~Ich sollte nun weiterziehen.~
@3827 = ~Dies ist das Dämmerwaldtal – eine kleine Lichtung, die vom Glauben an Eldath, der Göttin der Stillen Wasser und der stillen Haine, genährt wird. Das Tal ist ein Zufluchtsort für all jene, die Frieden und Ausgeglichenheit suchen. Wollt Ihr mehr erfahren?~
@3828 = ~Ja, erzählt mir mehr.~
@3829 = ~Nein, ich sollte weitergehen.~
@3830 = ~Das Dämmerwaldtal besteht seit langer Zeit – einer Zeit, als dieser Wald noch jung und unberührt war. Die ersten Anhänger Eldaths ließen sich damals hier nieder. Im Murmeln der Wasser vernahmen sie die Stimme der Göttin und errichteten ihr zu Ehren dieses Heiligtum.~
@3831 = ~Sie bauten keine Mauern. Die Bäume selbst umarmen uns. Wir schlafen in Hängematten zwischen den Ästen, und unser Atem mischt sich mit Wind und Wolken.~
@3832 = ~Die Wasser um uns gehören zu den Fällen der Grünen Göttin – heiligen Kaskaden, die sich in Becken sammeln, ehe sie als Fluss Rimril weiterziehen, sich mit dem Trifin-Bach vereinen und schließlich in den Fluss Amstel münden.~
@3833 = ~Und welchem Zweck dient dieser Ort?~
@3834 = ~Ihr habt mir viel zum Nachdenken gegeben. Lebt wohl.~
@3835 = ~Welchen Zweck braucht Frieden? Ihr findet hier keinen klassischen Tempel. Nur offenen Himmel und das sanfte Singen der Wasser. Frieden ist der Wille, Hass, Groll und Bitterkeit loszulassen. Und es gibt keinen geeigneteren Ort dafür als diesen.~
@3836 = ~An Frieden festzuklammern ist verborgene Feigheit. Helm lehrt Gerechtigkeit durch rechtschaffene Stärke, nicht durch passives Nichtstun.~
@3837 = ~In der Stille liegt Schönheit … doch Untätigkeit lädt zum Untergang ein. Selbst Wälder müssen sich verteidigen.~
@3838 = ~Kein Kämpfen? Aber wie soll das Böse dann seine Lektion lernen? Boo und ich sind sehr gute Lehrer!~
@3839 = ~Frieden ist ein Luxus für jene, die nicht von der Wirklichkeit der Welt bedrückt werden. Natur kann auch grausam sein.~
@3840 = ~Ein schaler Gedanke für Schwache und Machtlose. Macht, nicht Friedfertigkeit, formt die Reiche!~
@3841 = ~Wie sehr doch das alles nach Sterblichkeit klingt.~
@3842 = ~Meine Brüder lehren, dass Frieden das Ziel ist – nicht die Abwesenheit von Konflikten, sondern ihre Überwindung. Darin, so denke ich, unterscheiden wir uns nicht allzu sehr von den Lehren Eldaths.~
@3843 = ~Das Gewebe ist nicht friedlich. Es wandelt sich, es brennt, es verzehrt. Kann Frieden in einer Welt wie dieser wirklich Bestand haben?~
@3844 = ~Ihr sprecht vom Frieden, als sei er ein Ort, den man erreichen kann. Doch ich habe nie den rechten Weg dorthin gesehen.~
@3845 = ~Frieden ist etwas für Leute, die nie um ihren nächsten Atemzug kämpfen mussten.~
@3846 = ~Vielleicht ist Frieden nicht die Abwesenheit von Streit … sondern der Wille, ihn nicht weiter zu nähren.~
@3847 = ~Nette Ideale. Doch meiner Erfahrung nach folgt Frieden meist einer Klinge.~
@3848 = ~Klingt wunderbar!~
@3849 = ~Danke für Eure Worte. Ich muss nun gehen.~
@3850 = ~Genug Weisheit für heute. Es ist Zeit weiterzuziehen.~
@3851 = ~Flüsse fließen in Frieden, und doch formen sie das Land tiefer als jedes Heer. Denkt darüber nach, <LADYLORD>. Lebt wohl.~
@3852 = ~Sieh nur, Bruder! Eine neue Seele ist ins Dämmerwaldtal gekommen.~
@3853 = ~Friede sei mit Euch, zwergischer Sucher der Stille …~
@3854 = ~Hmpf.~
@3855 = ~Sagt uns, Bruder, wie lautet Euer Name?~
@3856 = ~Korgan. BLUTaxt.~
@3857 = ~Oh. So sagt uns, Bruder, wann habt Ihr zuletzt wahren Frieden gespürt?~
@3858 = ~Als ich diesem Menschen seinen hässlichen Kopf abgeschlagen habe.~
@3859 = ~Äh… und wann habt Ihr zuletzt ewige Stille gehört?~
@3860 = ~Als ich dem Halbling seine plappernde Zunge herausgeschnitten habe.~
@3861 = ~Mit einer solchen Haltung wird Euch niemand gern Gehör leihen!~
@3862 = ~Hatte nie Probleme damit! Hab ihre Ohren stets behalten. Gab eine feine Halskette!~
@3863 = ~Bei Eldath, er ist jenseits jeder Rettung.~
@3864 = ~Aye. Und stolz darauf!~
@3865 = ~Bei Eldath, Ihr habt ein Problem mit Eurem Zorn!~
@3866 = ~Nein, Ihr ersauft in Eurer Engstirnigkeit!~
@3867 = ~Er ist jenseits unserer Reichweite.~
@3868 = ~Frieden ist ein leicht übersehenes Geschenk, gnomischer Philosoph. Würdet Ihr nicht lieber still sitzen hier und dem Wald beim Atmen lauschen?~
@3869 = ~Ah, das Atmen! Niemand würdigt es gebührend. Man atmet, ohne nachzudenken. Und sobald man darüber nachdenkt, beginnt man sich zu fragen: Atme ich richtig? Zu flach? Zu tief? Was, wenn ich es vergesse? Meine Tante Belka hielt einmal die Luft an, um jung zu bleiben. Wurde ganz blau dabei, behauptete aber, es habe gewirkt. Und tatsächlich, sie sah zwanzig Jahre jünger aus, als man sie begrub.~
@3870 = ~Übrigens: Durchs Atmen habe ich herausgefunden, dass mein Vetter Jaffin gar nicht tot war. Hat den Totengräber zu Tode erschreckt. Dessen Geschäft ging den Bach runter.~
@3871 = ~Ich verstehe … Selbst klare Luft ist vor Euren Geschichten nicht sicher.~
@3872 = ~Seid gegrüßt, zauberkundige Elfe.~
@3873 = ~HALBelfe.~
@3874 = ~Eure Magie fließt sanft, wie Wasser über Stein.~
@3875 = ~Meine Magie fließt eher wie ein Wasserfall über eine Klippe. Mit Dampf. Und viel Getöse!~
@3876 = ~Ich … verstehe. Vielleicht verlangt Eldath von uns allen Geduld.~
@3877 = ~Ha! Das macht uns schon zu zweit!~
@3878 = ~Gesegnet seien die Stillen Wasser! Eine Dunkelelfe, die den Weg ans Licht gefunden hat – welch wunderbarer Anblick!~
@3879 = ~Ich verließ die eine Dunkelheit, nur um eine andere zu finden, Rivvil.~
@3880 = ~Und doch, unter der Sonne zu wandeln und zu leben … Fühlt Ihr Euch nun nicht endlich frei?~
@3881 = ~Frei? Die Sonne verbrennt meine Haut, der Regen peitscht mir ins Gesicht, und jeder törichte Priester glaubt, meine Seele reinigen zu müssen. Ich ertrage, doch Freiheit fühle ich nicht.~
@3882 = ~Vielleicht wird die Oberfläche Euch eines Tages ebenso annehmen, wie Eldath es täte.~
@3883 = ~Die Oberfläche nimmt niemanden an. Sie duldet. Ganz wie Eure Göttin, vermute ich.~
@3884 = ~Ich … verstehe. Vielleicht suchen nicht alle Flüsse dasselbe Meer.~
@3885 = ~Oder manche Wasser werden aus gutem Grunde schwarz.~
@3886 = ~Möge Eldaths Friede Euch dennoch finden. Selbst wenn sie lange suchen muss.~
@3887 = ~Krieger, habt Ihr je daran gedacht, Eure Feinde um Kapitulation zu bitten, BEVOR Ihr auf sie zustürmt?~
@3888 = ~Natürlich! Ich rufe immer „Ergebt Euch“, während ich stürme. Doch bevor sie antworten, antwortet mein Schwert. Es ist einfach schneller.~
@3889 = ~Vielleicht … solltet Ihr nächstes Mal auf die Antwort warten?~
@3890 = ~Aber zu warten, gibt dem Bösen Zeit zu denken! Besser, man haut es nieder, ehe es auf dumme Ideen kommt!~
@3891 = ~Dieser Gedanke verdient es, weiter verfolgt zu werden.~
@3892 = ~Ein bedenkenswerter Ansatz, Bruder.~
@3893 = ~Friedvolle Gedanken führen zu klarer Einsicht.~
@3894 = ~Ein Blütenblatt der Einsicht, getragen von ruhigem Wind.~
@3895 = ~Ein Gedanke, den man ins Licht halten sollte.~
@3896 = ~Ein stiller Teich spiegelt klarer als ein reißender Strom. Auf Besinnung folgt Erkenntnis.~
@3897 = ~Stille ist der Kern von Eldaths Lehre. Im Schweigen finden wir Wahrheit.~
@3898 = ~Schweigen, ja … doch nicht Untätigkeit. Selbst ein Fluss fließt, auch wenn er an der Oberfläche bewegungslos scheint.~
@3899 = ~Und doch spiegelt ruhiges Wasser klarer als ein reißender Strom. Handlung sollte erst nach Besinnung folgen.~
@3900 = ~Äh, verzeiht …~
@3901 = ~Ich werde weitergehen.~
@3902 = ~Besinnung ohne Bewegung ist Erstarrung. Frieden muss das Land durchschreiten, es darf nicht nur von ihm träumen.~
@3903 = ~Dann sind wir uns einig: Frieden verlangt nicht Untätigkeit, sondern besonnenes Handeln.~
@3904 = ~Wohl gesprochen. Mögen unsere Schritte leicht sein und unser Zweck fest verwurzelt.~
@3905 = ~Hallo? Hört Ihr mich überhaupt?~
@3906 = ~Ah… bei Eldaths Gnade, jemand ist hier! Vergebt uns, Reisender, wir waren in Gedanken versunken.~ ~Ah… bei Eldaths Gnade, jemand ist hier! Vergebt uns, Reisende, wir waren in Gedanken versunken.~
@3907 = ~Krieg ist die große Wunde der Welt. Wo er wütet, muss Harmonie mühsam neu wachsen.~
@3908 = ~Wohl wahr, doch manche sagen, ohne Krieg hätte Frieden keinen Wert. Was antworten wir ihnen?~
@3909 = ~Dass Frieden nicht die Abwesenheit von Leid ist, sondern die Heilung danach. Krieg ist Feuer, Frieden ist Regen.~
@3910 = ~Verzeiht die Störung, aber …~
@3911 = ~Und doch kommt mancher Regen zu spät. Ich habe Felder gesehen, die selbst Regen nicht mehr retten konnte.~
@3912 = ~Selbst die schwärzeste Erde kann wieder erblühen, wenn man ihr Zeit und Fürsorge schenkt. Eldath gibt keinen Boden auf.~
@3913 = ~Ich warte wohl besser, bis Ihr fertig seid.~
@3914 = ~Und mit der Zeit können Blumen dort wachsen, wo einst Banner standen.~
@3915 = ~Oh! Eldath bewahre, jemand hat die ganze Zeit zugehört!~
@3916 = ~Dann möge <PRO_HESHE> Frieden im Herzen tragen … und Geduld in den Ohren.~
@3917 = ~Wasser ist Eldaths Stimme. Es singt in Bächen und flüstert im Nebel.~
@3918 = ~Und doch hat es keine eigene Gestalt. Es nimmt jede Form an und widerstrebt keiner.~
@3919 = ~Schöne Worte, doch ich wollte nur fragen …~
@3920 = ~Gerade darin liegt seine Stärke. Indem es nachgibt, besteht es fort. In seiner Beständigkeit höhlt es jeden Stein.~
@3921 = ~Und wenn es aufgewühlt ist, spiegelt es nichts. Es erinnert uns daran, unsere Gedanken zur Ruhe zu bringen.~
@3922 = ~Ah… bei Eldaths Segen! Wir haben Euch gar nicht bemerkt, Freund. Ihr habt doch nicht lange gewartet, hoffe ich? Nun, wo waren wir stehen geblieben?~ ~Ah… bei Eldaths Segen! Wir haben Euch gar nicht bemerkt, Freundin. Ihr habt doch nicht lange gewartet, hoffe ich? Nun, wo waren wir stehen geblieben?~
@3923 = ~Von den Bienen können wir viel lernen: Sie arbeiten in Stille, fordern nichts und hinterlassen dennoch Süße und Heilung.~
@3924 = ~Ich bereite meinen Honig langsam und schonend gefiltert zu, wie Eldath es verlangt. Kein Rauch, kein Feuer … nur Geduld und ruhige Hände.~
@3925 = ~Honig beruhigt die Kehle, verschließt Wunden und trägt den Duft all der Blüten in sich, aus denen er geboren wurde. Ein stiller Segen in goldener Gestalt.~
@3926 = ~Jedes Glas, das ich verschließe, ist ein bewahrter Funke Frieden. Wenn die Welt sticht, erinnert ein Löffel Honig daran, dass nicht alles, was stechen könnte, Schmerz bedeutet.~
@3927 = ~Der Garten lehrt uns: Wachse in Stille, behüte alles, was wächst, und blühe erst, wenn die Zeit dafür reif ist.~
@3928 = ~Krieg verwundet die Welt. Blumen helfen ihr zu heilen. Eldath wusste wohl, was sie tat, als sie uns Blüten statt Klingen gab.~
@3929 = ~Frieden schlägt langsam Wurzeln, wie ein zarter Schössling. Man kann ihn nicht zwingen. Man kann nur den Boden pflegen und warten.~
@3930 = ~Möge Euer Zorn wie Reif in der Morgensonne vergehen, und mögen Eure Worte wie sanfte Wiesenblumen gedeihen.~
@3931 = ~Manche sagen, Blumen seien zerbrechlich. Ich sage, sie sind voller Zuversicht, denn sie blühen, obwohl sie wissen, wie kurz ihre Zeit sein wird.~
@3932 = ~Jeden Morgen spreche ich mit den Pflanzen. Sie kennen weder Lärm noch Eile, und doch gedeihen sie vortrefflich.~
@3933 = ~Gewalt mag ein Feld niedertrampeln, doch mit ausreichend Zeit kehrt das Grün zurück. Immer.~
@3934 = ~Nicht jede Heilung kommt durch Kräuter. Manchmal genügen ein stiller Ort und der Duft frischer Blüten.~
@3935 = ~Habt Ihr die Pflanze schon gefunden?~
@3936 = ~Nein, noch nicht.~
@3937 = ~Ich habe die Pflanze hier bei mir.~
@3938 = ~Ich werde Euch doch nicht helfen.~
@3939 = ~Ihr habt mit dem Hohepriester gesprochen, nicht wahr? Er möchte, dass Ihr diesen Talona-Priester sucht … und eine seltene Blume für das Gegenmittel findet. Jeder redet über diese Pflanze. Ihr Gift ist so mächtig, dass selbst die Götter es nicht zu kurieren vermögen.~
@3940 = ~Wir sind uns noch nicht begegnet. Mein Name ist Mannatarv. Ich bin alt und krank, sehr krank. Alles, was ich will, ist zu sterben. Doch die Priester Eldaths lassen mich nicht.~
@3941 = ~Wir sind uns schon begegnet. Mein Name ist Mannatarv. Ihr wisst, dass ich alt und krank bin. Alles, was ich will, ist zu sterben. Doch sie lassen mich nicht.~
@3942 = ~Die Priester heilen mich jeden Tag. Sie wirken ihre Magie auf mich, flicken meine Wunden, rufen mich zurück in Leben, wenn ich hinübergleite. Doch ich bin müde. Meine Knochen sind faul, mein Atem schwach. Jeder weitere Tag ist nur ein weiterer Tag voller Schmerz. Ich will keine Gnade mehr.~
@3943 = ~Ich bitte Euch: Bringt mir ein Blatt jener Blume, bevor sie ein Gegenmittel bereiten. Nur ein einziges Blatt. Lasst mich ihr Gift kosten und dahinscheiden. Lasst mich in Stille gehen – nicht unter ihren endlosen Gebeten.~
@3944 = ~Eine Seele, die um den Kuss des Todes bittet. Ich würde ihn gewähren, doch nicht zu rasch.~
@3945 = ~Wir dürfen uns nicht in den Lauf der Natur einmischen. Leben und Tod stehen nicht in unserer Macht.~
@3946 = ~Warum lange reden? Wenn er sterben will, dann erfüllen wir ihm diesen Wunsch. Eine Blume braucht es dafür nicht.~
@3947 = ~Manche Last ist schwerer, als ein Mensch sie tragen kann.~
@3948 = ~Ist die Zeit eines Menschen vorüber, wird der Fluss des Lebens ihn holen. Wir dürfen seinen Lauf weder beschleunigen noch aufhalten.~
@3949 = ~Barmherzigkeit und Mord liegen hier gefährlich nah beieinander. Ich kann ihm nicht guten Gewissens helfen.~
@3950 = ~Solche Gedanken sind Gotteslästerung. Es steht uns nicht zu, einen leichten Tod zu gewähren.~
@3951 = ~Leben ist Leid. Wenn er das Ende wünscht, sollten wir es ihm gewähren.~
@3952 = ~Sein Elend ist nicht unser Problem. Seht zu, dass er uns nicht aufhält.~
@3953 = ~Wenn der alte Narr verrecken will, gebt ihm das verfluchte Kraut.~
@3954 = ~Ihr wollt Euch mit dieser Pflanze selbst vergiften?~
@3955 = ~Nein. Ich werde keine Schuld an Eurem Tod tragen.~
@3956 = ~Wenn dies Euer Wunsch ist, bringe ich Euch die Pflanze.~
@3957 = ~Gibt es nicht einen anderen Weg?~
@3958 = ~Warum auf die Pflanze warten? Ich kann Euch jederzeit einen schnellen Tod bereiten.~
@3959 = ~Hm… noch ein Besucher. Spart Euch Eure Zuversicht, Fremder. Worte wiegen schwer, und ich habe kaum mehr Kraft, sie zu tragen.~ ~Hm… noch ein Besucher. Spart Euch Eure Zuversicht, Fremde. Worte wiegen schwer, und ich habe kaum mehr Kraft, sie zu tragen.~
@3960 = ~Die Priester kümmern sich schon genug um mich. Lasst einen alten Mann mit den kümmerlichen Resten seines Daseins allein. Besser Ihr verschwendet Euer Mitleid anderswo.~
@3961 = ~Ich wollte Euch nicht stören.~
@3962 = ~Ihr klingt krank. Kann ich Euch helfen?~
@3963 = ~Hmpf. Nein, nichts, das Ihr lindern könntet. Mein Fleisch verlässt mich, meine Knochen versagen, und dennoch lassen sie mich nicht gehen. Lasst mich in Ruhe, ehe Ihr Euer Mitgefühl vergeudet.~
@3964 = ~Wie Ihr wünscht. Lebt wohl.~
@3965 = ~Genug Worte … jedes einzelne zehrt an mir. Lebt wohl.~
@3966 = ~Noch immer hier? Hm. Es gibt nichts mehr zu sagen, nur den alten Schmerz zu ertragen. Geht, Fremder. Lasst den Wind Eure Schritte anderswohin tragen.~ ~Noch immer hier? Hm. Es gibt nichts mehr zu sagen, nur den alten Schmerz zu ertragen. Geht, Fremde. Lasst den Wind Eure Schritte anderswohin tragen.~
@3967 = ~Sehr wohl. Lebt wohl.~
@3968 = ~Ihr bringt sie wirklich zu mir? Ihr seid ein guter <PRO_RACE>! Lasst mich sehen …~
@3969 = ~So schön … und doch so tödlich. Hier, ich nehme nur ein Blatt. Die anderen sollen das Gegenmittel erhalten, nur ich nicht …~
@3970 = ~Ugh, das schmeckt aber bitter! Ich dachte nicht, dass …~
@3971 = ~Dann überlasst mich meinem Leid. Die Priester werden zufrieden sein.~
@3972 = ~Nein! Nicht hier, nicht im Heiligtum Eldaths. Kein Blut kann diesen heiligen Boden beflecken. Wenn Ihr mir wahrhaft Gnade erweisen wollt, dann ohne Gewalt.~
@3973 = ~Wenn Ihr es so sehen wollt, ja. Ich nenne es jedoch Erlösung.~
@3974 = ~Ihr … Ihr würdet das wirklich für mich tun? Ich danke Euch schon jetzt für Euren guten Willen. Ihr mögt an meinem Verstand zweifeln, doch Ihr zeigt Barmherzigkeit, wo andere nur meinen Leib heilen wollten. Ich werde in der Krankenstube auf Euch warten. Denkt daran, gebt mir ein Blatt, bevor Ihr die Pflanze zu Alatoasz bringt! Sobald er ein Gegenmittel erschafft, bleibt mir keine Hoffnung mehr auf einen stillen Abschied.~
@3975 = ~Viel Glück bei Eurer Suche, <PRO_RACE>. Ich zähle auf Euch und werde warten.~
@3976 = ~Ein anderer Weg? Nein. Ich habe alles versucht. Sogar beim Hochverehrten selbst gefleht. Nichts hilft. Darum brauche ich Euch.~
@3977 = ~Seid willkommen, Reisender. Ihr habt die Wipfelschänke betreten.~ ~Seid willkommen, Reisende. Ihr habt die Wipfelschänke betreten.~
@3978 = ~Was bietet Ihr hier an?~
@3979 = ~Heute nicht. Vielleicht ein andermal.~
@3980 = ~Zeigt mir, welche Annehmlichkeiten Ihr bereithaltet.~
@3981 = ~Dann möge der Wind Euch sanft tragen und Frieden Eure Schritte begleiten.~
@3982 = ~Einen Ort zur Rast unter freiem Himmel, geborgen in den Armen der Bäume. Decken, gewärmt von der Sonne des Tages, Hängematten zwischen uralten Ästen … und eine sanfte Stille, nur vom Gesang der Vögel unterbrochen.~
@3983 = ~Klingt, als könnte ich das gut gebrauchen.~
@3984 = ~Ein andermal vielleicht.~
@3985 = ~Dann legt Euch nieder und lasst die Bäume Euer Gewicht tragen. An diesem Ort vergisst die Welt ihre Last.~
@3986 = ~Wir gewähren Unterkunft in den Wipfeln und bieten Schlafplätze wie Nester zwischen den Ästen.~
@3987 = ~Wir reichen warmen Tee aus Hainkräutern, um den Geist zu beruhigen und traumlosen Schlaf zu schenken.~
@3988 = ~Frieden ist unser einziges wahres Angebot. Doch mitunter ist das mehr als genug.~
@3989 = ~Ich bleibe. Die Welt kann warten.~
@3990 = ~Ein andermal vielleicht.~
@3991 = ~(hust, hust) Entschuldigt den ganzen Qualm! Zu viele brennende Kerzen. Wollt Ihr etwas erwerben? (hust)~
@3992 = ~Was bietet Ihr an?~
@3993 = ~Lasst mich sehen, was Ihr habt.~
@3994 = ~Habt Ihr keine Sorge, dass all Eure Kerzen den ganzen Baum in Brand setzen könnten?~
@3995 = ~Oh, nein … (hust) Der Rauch hält das Ungeziefer fern. Ich habe nur einmal seit dem letzten Blattaustrieb einen Ast in Brand gesetzt, und meine Brüder und Schwestern waren rasch mit ihren Regenzaubern zur Stelle.~
@3996 = ~Genug geredet. Ich muss weiter.~
@3997 = ~Dann geht in Frieden … (hust) … und möge Euer Weg von Licht begleitet sein.~
@3998 = ~(hust)~
@3999 = ~Ich führe einige Schriftrollen. (hust) Manche schlicht, andere von kundiger Hand verzaubert.~
@4000 = ~Nun gut, zeigt sie mir.~
@4001 = ~Seid willkommen, <BROTHERSISTER>. Ihr steht an einem Ort der Stille, unter der sanften Gnade Eldaths, der Schweigsamen. Möge ihr Friede sich auf Euer Herz senken.~
@4002 = ~Ich würde gern Eure Dienste in Anspruch nehmen.~
@4003 = ~Könnt Ihr mir mehr über Eldath erzählen?~
@4004 = ~Ich verstehe. Ich werde nun gehen.~
@4005 = ~Gewiss, <BROTHERSISTER>. Tretet sanft auf, und lasst den Frieden Euren Weg leiten.~
@4006 = ~Möge Eldaths sanfter Atem Euch begleiten, <BROTHERSISTER>.~
@4007 = ~Eldath ist die Göttin des Friedens, der stillen Wasser und der ruhigen Haine. Wir gewähren jenen Zuflucht, die Harmonie suchen. Keine Klinge wird gezogen, wo ihr Segen verweilt.~
@4008 = ~Wenn ich noch einmal „Frieden“ höre, fange ich an, Bäume zu fällen. Dann Köpfe. In dieser Reihenfolge.~
@4009 = ~Keine Schwerter? Kein Zerschmettern? Nicht einmal ein kleines Hintern-Versohlen? Wie verwirrend …~
@4010 = ~Eine Göttin des Friedens … wie reizend. Wenn sie wirklich existiert, wird sie die Erste sein, die blutet.~
@4011 = ~Viele lachten über uns, als wir hier die ersten Setzlinge pflanzten. Und nun steht Ihr in ihrem Schatten.~
@4012 = ~Noch etwas?~
@4013 = ~Darf ich Eure Dienste sehen?~
@4014 = ~Ah, so ist es besser. Verzeiht, manchmal nehme ich die Gestalt eines Bären an, wenn die Sehnsucht zu groß wird. Mit Schnauze schmeckt Honig einfach süßer. Zumindest rede ich mir das ein.~
@4015 = ~Seid erneut gegrüßt, Honigliebhaber! Welche Süße führt Euch heute zu mir?~ ~Seid erneut gegrüßt, Honigliebhaberin! Welche Süße führt Euch heute zu mir?~
@4016 = ~Es geht um den Met.~
@4017 = ~Was tut Ihr hier eigentlich?~
@4018 = ~Ich will Euch nicht länger vom Honig abhalten. Lebt wohl.~
@4019 = ~Oh! Ihr bringt gute Nachrichten, hoffe ich?~
@4020 = ~Ich habe Euren Met dem Wirt des „Zu den Fünf Krügen“ überbracht.~
@4021 = ~Nein, noch gibt es nichts zu berichten.~
@4022 = ~Und? Hat er Euch einen angemessenen Preis gezahlt? Ein Jahr Arbeit steckte in diesem Nektar.~
@4023 = ~Er gab mir 100 Goldstücke.~
@4024 = ~Er gab mir 500 Goldstücke.~
@4025 = ~Er gab mir 750 Goldstücke.~
@4026 = ~Er gab mir 1.000 Goldstücke.~
@4027 = ~Nur 100? Das ist … enttäuschend. Samuel scheint Eldaths Frieden weniger wertzuschätzen als gewöhnliches Bier. Nun, was geschehen ist, ist geschehen. Ich werde damit auskommen, auch wenn mein Herz schwer ist.~
@4028 = ~Ahh, 500 Gold! Das ist ein gerechter Lohn für ein Jahr Mühe. Eldaths Gärten werden bunter erblühen! Hier, nehmt 100 Münzen für Euren Einsatz. Gute Arbeit verdient ihren Lohn.~
@4029 = ~750! Ha! Mehr als gerecht, mehr als ich zu hoffen gewagt habe! Wahrlich, Eldath lächelt heute auf uns herab. Nehmt diese 250 Goldstücke für Euch. Möge Euer Name so süß in Erinnerung bleiben wie Honig auf der Zunge.~
@4030 = ~1.000 Gold? Das ist überaus großzügig – nein, geradezu sensationell! Samuel muss nicht nur den Wert des Mets erkannt haben, sondern auch den Wert des Friedens selbst. Nehmt diese 500 Münzen und zudem dieses Geschenk – einen Mantel, gewoben, um Schutz vor Stichen zu gewähren, seien sie groß oder klein.~
@4031 = ~Nun, da ich Euch wieder in meiner eigenen Haut gegenüberstehe … Welchen Dienst könnte ein bescheidener Diener Eldaths Euch erweisen?~
@4032 = ~Ich will Euch nicht vom Honig fernhalten. Lebt wohl.~
@4033 = ~Was ich hier tue? Ich hüte die Bienen! Gemeinsam weben wir Harmonie in Waben und verwandeln Blüten in flüssiges Gold.~
@4034 = ~Ihr würdet staunen, wie viele Streitigkeiten vergehen, wenn die Lippen klebrig vor Honig sind.~
@4035 = ~Oh! Ich erkenne Euch! Ihr seid der <PRO_RACE> aus Athkatla, nicht wahr? Ich hätte eine Aufgabe für Euch, solltet Ihr in die Stadt der Münzen zurückkehren.~
@4036 = ~Warum sollte sich ein Priester Eldaths um die Stadt der Münzen kümmern?~
@4037 = ~Was verlangt Ihr von mir?~
@4038 = ~Ich bin kein Laufbursche. Sucht Euch jemand anderen.~
@4039 = ~In Athkatla steht die Schenke „Zu den Fünf Krügen“. Ihr Wirt, Samuel Donnerbölk, versteht etwas von feinem Genuss. Würdet Ihr einen Krug meines Honigmets zu ihm bringen? Handelt einen gerechten Preis aus, damit wir unsere Tempel und Gärten weiter pflegen können.~
@4040 = ~Gut. Ich werde Euren Honigmet zu Samuel vom „Zu den Fünf Krügen“ bringen.~
@4041 = ~Was versteht Ihr unter einem gerechten Preis?~
@4042 = ~Ihr kennt die Geschicke des Handels gewiss besser als ich. Fordert eine Summe, die den Wert des Mets ehrt, und kehrt mit dem Gold zu mir zurück. Mit diesen Münzen werden wir neue Güter für Eldaths Heiligtum im Tal erwerben, damit der Ort so sorgsam gepflegt werde wie ein Bienenstock.~
@4043 = ~Möge Samuel die Weisheit eines gerechten Handels erkennen. Kehrt mit der Bezahlung zurück, und ich werde Euch einen Anteil gewähren. Denn wer Gutes sät, soll auch die Früchte ernten.~
@4044 = ~So sei es. Ein Bienenstock lehrt Geduld. Vielleicht wird an einem anderen Tag ein anderer Mensch Eldaths Süße in die Welt tragen.~
@4045 = ~Lebt wohl! Bleibt ruhig und summt im Takt der Bienen.~
@4046 = ~Ein Bienenstock lehrt uns: Arbeite in Stille, hüte das Süße, und stich nur, wenn es wirklich sein muss.~
@4047 = ~Möge Euer Zorn wie Wachs unter der Flamme schmelzen, und mögen Eure Worte so süß sein wie Sommerhonig. Tragt ein wenig Süße in die Welt.~
@4048 = ~Frieden braucht Geduld. Wie guter Honig. Man kann die Bienen nicht hetzen, und Streithähne ebenso wenig.~
@4049 = ~Möge Euer Zorn wie Wachs schmelzen und Eure Worte süß wie Sommerhonig sein.~
@4050 = ~Ich habe hier Honigmet von einem Priester Eldaths aus dem Dämmerwaldtal.~
@4051 = ~Galad, seht Euch diesen goldenen Schimmer an! Wenn der Geschmack nur annähernd der Farbe entspricht, ist dies kein einfaches Bauerngebräu. Ein Priester Eldaths, sagt Ihr? Meine Gäste werden auf die Harmonie trinken, und Zwietracht wird sich verflüchtigen, noch ehe der erste Krug geleert sein wird.~
@4052 = ~Der Mönch bat um einen gerechten Preis.~
@4053 = ~Solcher Met verdient keinen gewöhnlichen Preis. Was bietet Ihr dafür, Samuel?~
@4054 = ~Ein verständlicher Wunsch – und ich bin kein Geizhals, wenn es um Qualität geht. Wie viel verlangt Ihr für den Met?~
@4055 = ~Ich verlange 100 Goldstücke.~
@4056 = ~Ich verlange 500 Goldstücke.~
@4057 = ~Ich verlange 750 Goldstücke.~
@4058 = ~Ich verlange 1.000 Goldstücke.~
@4059 = ~Welch ein Schnäppchen! Die Priester Eldaths scheinen den wahren Wert ihres Getränks nicht zu kennen. Hier, nehmt Eure 100 Goldstücke.~
@4060 = ~Abgemacht! Hier sind 500 Gold. Eine gerechte Summe. Richtet Eurem Mönch aus, es möge sowohl Schenke als auch seinem Tempel Wohlstand bringen.~
@4061 = ~Einverstanden! 750 Gold! Der Nektar ist fein, und der Zweck noch feiner. Möge Eldath meine Großzügigkeit – und den Durst meiner Gäste – segnen!~
@4062 = ~Ein Königslohn! Doch solche Süße lässt sich kaum in Münzen messen. So nehmt die 1.000 Gold. Jeder soll sagen, dass Samuel Donnerbölk hervorragende Braukunst und edle Taten gleichermaßen belohnt.~
@4063 = ~Richtet den Anhängern Eldaths meine Grüße aus. Ich hätte nicht gedacht, dass sie zu etwas derart Nützlichem fähig sind!~
@4064 = ~Seid gegrüßt. Ich bin der Holzwerker von Dämmerwaldtal, obgleich ich in erster Linie Druide bin.~
@4065 = ~Aus Ästen schnitze ich kleine Tiere oder Schmuckstücke. Bisweilen sammle ich hölzerne, druidische Ausrüstung, die ihren Weg zu mir findet. Ich fertige sogar Rüstungen aus Dämmerholz – leicht und robust. Möchtet Ihr meine Waren sehen?~
@4066 = ~Zeigt mir, was Ihr habt.~
@4067 = ~Nicht jetzt.~
@4068 = ~Warum schnitzt Ihr Holz?~
@4069 = ~Gehen Euch hier nie die Bäume aus?~
@4070 = ~Wird Eure Arbeit wirklich geschätzt?~
@4071 = ~Schon wieder hier? Das Holz hält mich beschäftigt. Wollt Ihr meine Arbeiten sehen?~
@4072 = ~Ja, zeigt sie mir.~
@4073 = ~Heute nicht.~
@4074 = ~Es beruhigt Hände und Herz. Eine kleine Schnitzerei kann mehr Trost spenden als eine Münze.~
@4075 = ~Wenn Ihr möchtet, zeige ich Euch meine Werke.~
@4076 = ~Ich fälle niemals lebendes Holz. Der Wald selbst überlässt mir alte Stämme und Äste in Hülle und Fülle.~
@4077 = ~Möchtet Ihr einen Blick darauf werfen?~
@4078 = ~Genug, um zu bestehen. Ein Lächeln gilt mir als voller Lohn.~
@4079 = ~Soll ich meine Arbeit zeigen?~
@4080 = ~Was darf es sein?~
@4081 = ~Zeigt mir Eure Arbeiten.~
@4082 = ~Ein andermal.~
@4083 = ~Wie Ihr wünscht. Holz kann warten.~
@4084 = ~Ganz wie Ihr wollt. Ich halte die Späne beisammen.~
@4085 = ~Wie Ihr wünscht. Holz kann warten.~
@4086 = ~Ein neuer Tag, eine neue Schnitzerei. Geht sichere Wege.~
@4087 = ~Ah, Freund! Wir danken Euch noch immer. Ihr habt uns auf Straße Leben gerettet.~
@4088 = ~Nun spaltet Axt nur noch Kürbisse, nicht mehr Köpfe. Bessere Arbeit. Besseres Leben.~
@4089 = ~Oh! Idee. Hier, wir geben Euch alte Axt. Als Dank. Brauchen sie nicht mehr. Benutzen jetzt andere Axt, die nur für Kürbisse taugt.~
@4090 = ~Axt half uns, den Weg zu Eldath zu finden. Vielleicht hilft sie nun Euch.~
@4091 = ~Gut zu sehen, dass es Euch gut geht.~
@4092 = ~Ich bin überrascht, dass Ihr es tatsächlich bis hierher geschafft habt.~
@4093 = ~Ich bin sicher, ich werde die Axt für Besseres nutzen als für Kürbisse.~
@4094 = ~Oh, Ihr schon wieder! Keine Sorge, diesmal keine Gefahr. Ich spalte nur Kürbisse.~
@4095 = ~Gut zu sehen, dass Ihr am Leben seid und Frieden gefunden habt.~
@4096 = ~Warum ausgerechnet Kürbisse?~
@4097 = ~Ich überlasse Euch Euren Kürbissen.~
@4098 = ~Ihr freundlich. Wir danken nochmals.~
@4099 = ~Wenn Ihr nach Dämmerwaldtal kommt, singen wir kleinen Dank und teilen Eintopf.~
@4100 = ~Vielleicht komme ich vorbei.~
@4101 = ~Behaltet Eure Lieder für Euch.~
@4102 = ~Gut. Ihr willkommen. Eldath segne den Weg, der Euch herbrachte.~
@4103 = ~Wie Ihr wollt. Dennoch … Ihr habt uns gerettet. Wir vergessen nicht.~
@4104 = ~Kürbis gibt Nahrung. Kürbis fühlt sich beim Spalten an wie Kopf, aber spritzt nicht mit Blut.~
@4105 = ~Axt noch schwer, aber Herz leichter. Kürbisse müssen gespalten werden. Wir beschäftigt und glücklich.~
@4106 = ~Das klingt in der Tat friedlich.~
@4107 = ~Ihr könntet mich anlügen.~
@4108 = ~Ja. Frieden gut. Danke.~
@4109 = ~Wir lügen nicht. Ihr beobachten. Wenn wir arbeiten, Ihr sehen. Wenn nicht, Ihr auch sehen.~
@4110 = ~Lebt wohl. Haltet die Axt scharf, Freund – aber nur für Kürbisse!~
@4111 = ~Danke, dass Ihr uns gerettet habt!~
@4112 = ~Verzeiht … Ihr seid doch derjenige, der unserem Hochverehrten geholfen hat, nicht wahr? Ich fragte mich, ob Ihr vielleicht auch mir helfen würdet.~
@4113 = ~Kommt darauf an. Was braucht Ihr?~
@4114 = ~Ich habe keine Zeit, Jungen zu helfen, die noch zu jung sind, um sich zu rasieren. Geh und spiel in den Bäumen!~
@4115 = ~Seht, erst kürzlich bin ich von zu Hause fortgelaufen. Ich konnte mein bisheriges Leben einfach nicht mehr ertragen! Meine Eltern sind gestorben, als ich noch jung war, und ich wurde von meiner Tante Pesca großgezogen. Sie lebt im Regierungsviertel von Athkatla. Ihre Welt besteht aus Marmor, Seide und Münzen. Sie wollte, dass ich ein vornehmer, edler Mann werde. Privilegiert. Gepudert. Verwöhnt.~
@4116 = ~Doch nichts davon fühlte sich richtig an, nicht meine Kleidung, nicht meine Manieren, schon gar nicht meine Zukunft. Eines Tages regte sich etwas in mir – eine tiefe Ruhe, gefolgt von einem Ruf. Es war Eldaths Stimme.~
@4117 = ~Also kam ich hierher, ins Dämmerwaldtal, um zu lernen, zu atmen, und um meinen eigenen Weg im Leben zu finden. Aber ich ging ohne ein Wort des Abschieds und verschwand einfach. Das war nicht richtig.~
@4118 = ~Ich kann nicht zurück, meine Tante würde mich nie wieder gehen lassen. Doch vielleicht, wenn jemand ihr diese Blume brächte und ihr sagte, dass es mir gut geht, da wo ich jetzt bin? Vielleicht könnte dann Frieden herrschen zwischen mir und meiner Tante?~
@4119 = ~Sie lebt in Athkatla. Für gewöhnlich flaniert sie durch die Gärten des Regierungsviertels. Würdet Ihr ihr diese Blume bringen und meine Botschaft übermitteln?~
@4120 = ~Gut. Ich werde es tun.~
@4121 = ~Das ist Euer Problem, nicht meines.~
@4122 = ~Wirklich? Danke! Hier, nehmt die Blume. Meine Tante Pesca verlässt das Regierungsviertel selten. Sie beteuert stets, die Stadt der Münzen sei alles, was sie brauche.~
@4123 = ~Lasst mich wissen, sobald Ihr ihr die Blume überreicht habt. Ich wäre Euch sehr dankbar.~
@4124 = ~R-Richtig … Entschuldigt die Störung.~
@4125 = ~Ich hoffe wirklich, dass meine Tante versteht, dass ich Luft zum Atmen brauche. Dass ich ein anderes Leben führen möchte als sie. Ich bin nicht von ihr fortgelaufen. Ich bin auf etwas zugelaufen, das mich rief: mein eigenes Leben.~
@4126 = ~Ich habe Eure Botschaft überbracht und ihr die Blume gegeben. Sie meinte, vielleicht solltet Ihr ihr eines Tages selbst Blumen bringen.~
@4127 = ~Ich habe ihr die Blume gegeben. Es überrascht mich nicht, dass Ihr fortgegangen seid. Sie ist unausstehlich.~
@4128 = ~Hmm…~
@4129 = ~Das hat sie gesagt? Damit hätte ich nicht gerechnet.~
@4130 = ~Nun, so schlimm ist sie auch nicht. Ich meine … manchmal kann sie auch ganz nett sein.~
@4131 = ~Danke, dass Ihr das getan habt. Es bedeutet mir mehr, als ich sagen kann. Jetzt, da sie weiß, dass ich in Sicherheit bin, kann ich mich wirklich auf das konzentrieren, was für mich zählt.~
@4132 = ~Was auch immer das genau sein mag. Ich finde es noch heraus. Aber danke. Wirklich. Ihr seid voll in Ordnung!~
@4133 = ~Friede sei mit Euch! Ihr tragt den Geruch von Erde und Gefahr an Euch. Wart Ihr in Verliesen oder an einem anderen finsteren Ort? Ich weiß nicht, ob ich für solche Wege geschaffen bin …~
@4134 = ~Was ist das hier wieder für ein Gedränge? Ich habe weder Zeit noch Geduld für ungebetene Störungen. Verschwindet, es sei denn, Ihr tragt etwas von wirklicher Bedeutung vor.~
@4135 = ~Ich habe Euren Neffen getroffen. Ich soll Euch von ihm ausrichten, dass es ihm gut geht. Er ist fortgegangen, weil er sein Leben auf eigene Weise leben will und bat mich, Euch diese Blume zu überreichen.~
@4136 = ~Nun gut. Ich werde dann gehen.~
@4137 = ~Er tat was? Er lebt? Ich dachte … ich fürchtete das Schlimmste. Und dennoch läuft er fort, verschwindet ohne ein einziges Wort? Welche Unverschämtheit!~
@4138 = ~Undankbarer Bengel! Ich habe ihn behütet, gekleidet, erzogen, ihm alles gegeben – und so dankt er es mir?~
@4139 = ~Vielleicht liegt genau darin das Problem.~
@4140 = ~Gnädige Frau, ich überbringe nur eine Nachricht. Er ist in Sicherheit. Ihr werdet ihn wiedersehen, da bin ich sicher. Mehr müsst Ihr nicht wissen.~
@4141 = ~Wie wagt Ihr es, so etwas zu sagen?~
@4142 = ~Er will sein eigenes Leben führen, seine eigenen Fehler machen. Er weiß, dass Ihr es gut meint. Doch er möchte seinen eigenen Weg finden.~
@4143 = ~Und was, bitteschön, fehlte ihm hier? Wir haben alles – Komfort, Schönheit, Sicherheit! Seht Euch dieses Viertel an! Es gibt nichts jenseits dieser Mauern, das ihm besser dienen könnte als das, was ich ihm bot!~
@4144 = ~Es geht ihm gut. Gebt ihm Zeit. Lasst ihn stolpern. Lasst ihn wieder aufstehen.~
@4145 = ~Ich …~
@4146 = ~Er kommt zurecht. Konzentriert Euch darauf.~
@4147 = ~Nun gut. Sagt ihm … sagt ihm, er solle mir das nächste Mal die Blumen selbst bringen. Hmpf. Dieser unverschämte, törichte, liebenswerte Bengel!~
@4148 = ~Hmpf! Dann verschwindet und geht mir aus den Augen!~
@4149 = ~He! Habt Ihr Würmer?~
@4150 = ~Nein, ich erfreue mich bester Gesundheit.~
@4151 = ~Ähm, ich glaube nicht. Tut mir leid.~
@4152 = ~Darauf werde ich nicht antworten. Lebt wohl.~
@4153 = ~Wie kommt ein Kind wie du an einen solchen Ort?~
@4154 = ~Was … Igitt! So war das nicht gemeint!~
@4155 = ~Oh … nun gut. Schade eigentlich.~
@4156 = ~Ich bin ein Waisenkind. Die Priester hier nahmen mich auf, als ich sonst niemanden hatte. Sie sagen, die Göttin wende sich nicht einmal vom kleinsten Blatt ab, das im Strom treibt.~
@4157 = ~Also … helft Ihr mir jetzt, Würmer zu finden, oder nicht?~
@4158 = ~Ich will UNBEDINGT ein paar gute Fische fangen und allen zeigen, was für ein toller Fischerjunge ich bin! Aber dafür brauche ich einen richtig fetten Wurm. Sagt mir Bescheid, wenn Ihr einen findet.~
@4159 = ~Hier müssten doch irgendwo Würmer sein …~
@4160 = ~Hm, immer noch kein Glück bei der Wurmsuche. Ernsthaft, wie schwer kann das sein? Wo sind all die Würmer, wenn man sie mal braucht? Ich habe überall gesucht.~
@4161 = ~Schau mal! Ich habe einen Wurm für dich.~
@4162 = ~Geduld. Du wirst schon einen finden.~
@4163 = ~Wirklich?! Das ist ja großartig!~
@4164 = ~Schaut nur, wie groß er ist! Und wie rosa! Und wie lustig er sich windet!~
@4165 = ~Tut mir leid, aber jetzt muss ich dich an den Haken stecken. Ich hoffe wirklich, dass es nicht allzu sehr weh tut.~
@4166 = ~…~
@4167 = ~… äähm…~
@4168 = ~Oh nein. Ich kann ihn doch nicht einfach töten? Er sieht so nett aus. Und ich … ich will ihn „Nudel“ nennen und ihm Tricks beibringen!~
@4169 = ~So ein Wesen sollte wirklich kein Fischfutter sein!~
@4170 = ~Sieht so aus, als würdest du ihn einfach zu sehr mögen.~
@4171 = ~Ach, ich hab genug davon. (Wurm nehmen und ins Wasser werfen)~
@4172 = ~Irgendwie schon.~
@4173 = ~Hm, dann werde ich wohl doch kein Fischerjunge. Aber wisst Ihr was? Ich kann Wurm-Zähmer werden!~
@4174 = ~Danke, dass Ihr ihn mir gebracht habt. Ich glaube, wir werden gute Freunde.~
@4175 = ~Was?! Was habt Ihr getan?! Ihr seid sooo gemein, und ich werde allen erzählen, dass Ihr ganz arg schrecklich seid! Und dann wird Euch keiner mehr mögen! NIEMALS!~
@4176 = ~He! Wisst Ihr was? Ich habe Nudel einen neuen Trick beigebracht! Vielleicht zeige ich ihn Euch beim nächsten Mal.~
@4177 = ~Eldath wache über Euch, mein Freund. Es ist ein Segen, einer weiteren Seele zu begegnen, die im Frieden wandelt.~
@4178 = ~Ich denke, Ihr solltet dies erhalten. Dies ist das Emblem Eldaths, das Merethan trug, bevor er starb. Er hätte gewollt, dass es weiter getragen wird.~
@4179 = ~Ich habe mit Alatoasz gesprochen. Er hält Euch für würdig, Merethans Emblem zu tragen.~
@4180 = ~Ihr wirkt ruhig und zufrieden. Lebt Ihr schon lange hier, Priesterin?~
@4181 = ~Wie gefällt Euch dieser Ort, Priesterin? Das Dämmerwaldtal scheint ein ruhiger Ort in einer unruhigen Welt zu sein.~
@4182 = ~Das geht mich nichts an. Lebt wohl.~
@4183 = ~Möge der Friede mit Euch gehen. Lebt wohl.~
@4184 = ~Ich traf eine zornige Sirene. Ihr hingegen lebt in Frieden und Gelassenheit – könnt Ihr mir sagen, wie ich der Sirene helfen kann?~
@4185 = ~Oh ja, ich lebe bereits seit vielen Jahren hier, umgeben von sanften Seelen und dem unaufhörlichen Murmeln der Wasser.~
@4186 = ~Einst verbrachte ich meine Tage damit, das Zeichen unserer Herrin in Holz und Stein zu schnitzen … doch meine Hände gehorchen mir nicht mehr wie damals.~
@4187 = ~Ach, wie sehr wünschte ich, ich könnte eines dieser schönen Symbole Eldaths noch einmal selbst schnitzen, wie früher! Doch ich betrauere nicht, was die Zeit mir genommen hat.~
@4188 = ~Nun lehre ich die Jüngeren das Schnitzen. Ihre Hände sind meine Hände, und durch sie blühen die Zeichen der Herrin weiter. Auch Merethan habe ich gelehrt, sein Emblem zu fertigen. Schade, dass er nicht mehr Frieden in die Welt bringen konnte, ehe die Göttin ihn zu sich rief.~
@4189 = ~Nun sagt mir, sucht Ihr etwas oder ruht Ihr nur einen Moment Eure Seele aus?~
@4190 = ~Ich muss gehen, ich habe genug von Eurem Gerede.~
@4191 = ~Ich wollte Euch nur einen friedvollen Tag wünschen.~
@4192 = ~Ja … dieser Ort strahlt Frieden aus. Nach all dem Lärm da draußen ist es wohltuend, hier der Stille zu lauschen.~
@4193 = ~Ein Fluss eilt nie, und doch erreicht er das Meer. Vielleicht sollten wir von ihm lernen.~
@4194 = ~Ihr wirkt nachdenklich. Vermisst Ihr Eure früheren Aufgaben?~
@4195 = ~Wie auch immer. Ich muss gehen.~
@4196 = ~Danke, dass Ihr diesen Frieden mit mir geteilt habt.~
@4197 = ~Ihr wollt mir Merethans Emblem überlassen? Das ist eine große Ehre, die ich nicht leichtfertig annehmen kann. Eine solche Entscheidung muss vom Hochverehrten Hüter der Stillen Wasser selbst kommen.~
@4198 = ~Soll ich in Eurem Namen mit dem Hohepriester sprechen?~
@4199 = ~Ich habe bereits mit ihm gesprochen. Er wünscht, dass Ihr es tragt.~
@4200 = ~Es war nur ein Gedanke. Ich habe anderes zu tun.~
@4201 = ~Das wäre ein großes Geschenk. Doch selbst wenn er ablehnt, werde ich mich nicht weniger gesegnet fühlen. Die Herrin lehrt, dass Frieden in Bescheidenheit liegt.~
@4202 = ~Der Hochverehrte gewährt mir die Ehre, Merethans Emblem zu tragen? Dann schließt sich der Kreis wahrhaftig.~
@4203 = ~Ich habe nicht mehr anzubieten als meinen Dank. Ich werde Eurer im Gebet zur Herrin der Stillen Wasser gedenken.~
@4204 = ~Dank Euch wandle ich wieder in Frieden – langsam, doch mit stetem Schritt.~
@4205 = ~Lebt wohl. Meine Hände mögen zittern, doch mein Herz ist fest. Möge es mit dem Euren ebenso sein, wohin auch immer Euer Weg führt.~
@4206 = ~Meine Schwester der Gezeiten ist in ihrem Zorn gefangen?~
@4207 = ~Bringt ihr dies – geweihtes Wasser, vermischt mit Kamille, wildem Honig, Brombeere und Lavendel. Das lässt Ärger dahinschmelzen wie Winterreif in Morgensonne.~
@4208 = ~Vielleicht sollten wir unserem zornigen Zwerg hier ebenfalls etwas von diesem Gebräu anbieten?~
@4209 = ~Ha! Sehr witzig, Halbelfe! Mein Zorn beugt sich keinem Trank! Nun schert Euch fort, ehe ich einen triftigen Grund finde, wirklich wütend zu werden!~
@4210 = ~Lasst meine Schwester diesen Trank unter freiem Himmel trinken. Ist ihr Geist bereit, wird Eldaths Ruhe ihren Zorn besänftigen.~
@4211 = ~Danke, das wird ihr helfen.~
@4212 = ~Hoffentlich wirkt es.~
@4213 = ~Gut. Ich bringe das Gebräu zu Eurer salzigen Schwester.~
@4214 = ~Tragt Ruhe als Schild und Güte als Klinge.~
@4215 = ~Argh!~ [SIRIN03]
@4216 = ~Hier scheint jemand wütend zu sein.~
@4217 = ~Ihr seid die Einzige hier, die keine Harmonie zeigt.~
@4218 = ~Ich lasse Euch besser wieder allein.~
@4219 = ~Natürlich bin ich wütend! Wenn die Lieder der Welt zu einem Schreien werden, wie sollte ich es nicht sein? Die Reiche erbeben vor Krieg und Wahnsinn, als sei Toril selbst dem Irrsinn verfallen.~
@4220 = ~Ich kam hierher, nachdem mein Volk mit Piraten aneinandergeriet. Ich sah viel Tod, Blut und Leid. Zu viel davon. Und nun brennt diese Erinnerung in mir und ich werde sie nicht los.~
@4221 = ~Manchmal will ich einfach einen weiteren Pfeil anlegen und allem ein Ende bereiten … die Welt zum Frieden zwingen, wenn es sein muss.~
@4222 = ~Doch ich suchte Frieden, nicht Rache. Als Eldaths Stimme mich erreichte – sanft wie Wellen an einem Ufer –, glaubte ich, die Wut versinken lassen zu können. Nun haftet sie noch immer an mir, wie Tang um ein Herz.~
@4223 = ~Es tut mir sehr leid, das zu hören.~
@4224 = ~Ich wusste nicht, dass Eldaths Ruf auch Wesen wie Euch erreicht.~
@4225 = ~Ich glaube, das interessiert mich nicht. Ich gehe.~
@4226 = ~Überrascht? Das war ich auch. Doch selbst sturmgepeinigte Herzen sehnen sich nach Ruhe. Und ihre Stimme war die einzige, die kein Blut verlangte.~
@4227 = ~Interessant.~
@4228 = ~Mein Herz trauert, wahrlich … doch die Wut peitscht in mir wie die steigende Flut.~
@4229 = ~Dann geht! Verschwindet! Je eher Ihr fort seid, desto stiller wird es.~
@4230 = ~Argh!~
@4231 = ~Ich lasse Euch besser in Ruhe.~
@4232 = ~Ich habe mit einer alten Priesterin gesprochen. Sie hat mir diesen Kräutertrank gegeben, um Euch zur Ruhe zu verhelfen.~
@4233 = ~Hier, ein Schluck dieses Kräutergebräus und Eure Sorgen vergehen. So behauptet es zumindest die alte Frau.~
@4234 = ~Ein Kräutertrank? Ihr glaubt, ein paar Schlucke lassen mich all das vergessen, was ich gesehen habe?~
@4235 = ~Nun, einen Versuch ist es wert.~
@4236 = ~Habt Ihr eine bessere Idee?~
@4237 = ~Um ehrlich zu sein, nein.~
@4238 = ~Wie Ihr wollt. Ich wollte helfen, doch vielleicht seid Ihr dazu nicht bereit.~
@4239 = ~Nun … ich schätze, ich kann es zumindest versuchen.~
@4240 = ~Es fühlt sich … angenehm an.~
@4241 = ~Seht Ihr? Das war doch gar nicht so schwer.~
@4242 = ~Das lief besser als erwartet.~
@4243 = ~Genießt diesen Moment. Ich lasse Euch nun allein.~
@4244 = ~Ein Hauch von Ruhe, endlich … das einzige Gewicht, das ich noch trage, ist dieser Köcher voller Pfeile – die stete Erinnerung an das Leben, das ich einst führte.~
@4245 = ~Ich hielt diese Pfeile länger bei mir, als ich mich erinnern kann, doch nun ziehen sie mich zurück, statt mich zu befreien – zumindest hier, an diesem Ort.~
@4246 = ~Ihr hingegen scheint jemand zu sein, der sie noch gebrauchen könnte. Nehmt sie. Sie haben mir gute Dienste geleistet, doch vielleicht dienen sie Euch besser. Ihr habt meinen Dank … und vielleicht einen Teil meines Friedens.~
@4247 = ~Ich möchte gerade nicht sprechen … Ich will nur dem Wasser zusehen.~
@4248 = ~Ich weiß nicht, warum ich glaubte, dieser Ort würde alles besser machen …~
@4249 = ~(seufz)~
